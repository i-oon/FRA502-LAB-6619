<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="example">
    <link name="link_0">
        <visual>
            <geometry>
                <mesh filename="package://example_description/meshes/link_0.stl"/>
            </geometry>
        </visual>
    </link>

    <joint name="link_0_to_link_1" type="revolute">
        <parent link="link_0"/>
        <child link="link_1"/>
        <origin xyz="0 0 0.23"/>
        <axis xyz="0.0 0.0 1.0"/>
        <limit lower="-3.1459" upper="3.1459" effort="0.0" velocity="0.0"/>
    </joint>

    <link name="link_1">
        <visual>
            <geometry>
                <mesh filename="package://example_description/meshes/link_1.stl"/>
            </geometry>
        </visual>
    </link>

    <joint name="link_1_to_link_2" type="revolute">
        <parent link="link_1"/>
        <child link="link_2"/>
        <origin xyz="0 -0.12 0" rpy= "${-3.14/2} ${-3.14/2} 0"/>
        <axis xyz="0.0 0.0 1.0"/>
        <limit lower="-3.1459" upper="3.1459" effort="0.0" velocity="0.0"/>
    </joint>

    <link name="link_2">
        <origin xyz="0.0 0.0 0.0"/>
        <visual>
            <geometry>
                <mesh filename="package://example_description/meshes/link_2.stl"/>
            </geometry>
        </visual>
    </link>

    <joint name="link_2_to_link_3" type="revolute">
        <parent link="link_2"/>
        <child link="link_3"/>
        <origin xyz="0.25 0 0.1" rpy= "0 0 0"/>
        <axis xyz="0.0 0.0 1.0"/>
        <limit lower="-3.1459" upper="3.1459" effort="0.0" velocity="0.0"/>
    </joint>

    <link name="link_3">
        <origin xyz="0.0 0.0 0.0"/>
        <visual>
            <geometry>
                <mesh filename="package://example_description/meshes/link_3.stl"/>
            </geometry>
        </visual>
    </link>

    <joint name="link_3_to_end" type="fixed">
        <parent link="link_3"/>
        <child link="end_effector"/>
        <origin xyz="0.28 0 0" rpy= "0 0 0"/>
        <axis xyz="0.0 0.0 1.0"/>
        <limit lower="-3.1459" upper="3.1459" effort="0.0" velocity="0.0"/>
    </joint>

    <link name="end_effector">
        <visual>
            <geometry>
                <mesh filename="package://example_description/meshes/end_effector.stl"/>
            </geometry>
            <origin xyz="0 0 0" rpy= "0 ${3.14/2} 0"/>
        </visual>
    </link>

</robot>
